{
  "info": {
    "_postman_id": "bc77d4e5-9a49-4c8f-aad9-3aef15182731",
    "name": "Orbit Job Portal API",
    "description": "Smoke tests and example requests for the Orbit REST API. Register and sign in with the appropriate role before running protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API is healthy', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register candidate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jordan Lee\",\n  \"email\": \"jordan@example.com\",\n  \"password\": \"change-this-password\",\n  \"role\": \"candidate\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jordan@example.com\",\n  \"password\": \"change-this-password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sign in returns a token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.token).to.be.a('string');",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Search jobs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/jobs?sort=newest&page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Search returns a paginated result', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const result = pm.response.json().data;",
                  "  pm.expect(result.items).to.be.an('array');",
                  "  pm.expect(result.pagination).to.have.property('pages');",
                  "  if (result.items.length) pm.collectionVariables.set('jobId', result.items[0]._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get job details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/jobs/{{jobId}}"
          }
        },
        {
          "name": "Post a job (recruiter/admin)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Frontend Engineer\",\n  \"company\": \"Northstar Studio\",\n  \"location\": \"Remote\",\n  \"type\": \"Full-time\",\n  \"experience\": \"Mid-level\",\n  \"salaryMin\": 80000,\n  \"salaryMax\": 110000,\n  \"description\": \"Build thoughtful, accessible web experiences with a collaborative product team.\",\n  \"skills\": [\"React\", \"JavaScript\"],\n  \"requirements\": [\"Experience shipping React applications\"]\n}"
            },
            "url": "{{baseUrl}}/api/jobs"
          }
        },
        {
          "name": "List my job listings (recruiter/admin)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/jobs/mine?page=1&limit=10"
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Apply for a job (candidate)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{jobId}}\",\n  \"coverLetter\": \"I would love to bring my experience to your team.\"\n}"
            },
            "url": "{{baseUrl}}/api/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application was submitted', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('applicationId', pm.response.json().data.application._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Track my applications",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/applications?page=1&limit=10"
          }
        },
        {
          "name": "Update application status (recruiter/admin)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"reviewing\"\n}"
            },
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/status"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Platform overview (admin)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/admin/overview"
          }
        },
        {
          "name": "Search users (admin)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/admin/users?page=1&limit=20"
          }
        }
      ]
    }
  ]
}
